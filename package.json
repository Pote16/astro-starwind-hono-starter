{
  "name": "astro-hono-setup",
  "private": true,
  "scripts": {
    "dev": "bun --bun run --filter '*' dev",
    "dev:frontend": "bun --bun run --filter frontend dev",
    "dev:backend": "bun --bun run --filter backend dev",
    "build": "bun --bun run --filter '*' build",
    "lint": "bun --bun run --filter '*' lint && bun --bun eslint e2e playwright.config.ts",
    "lint:fix": "bunx --bun eslint apps/backend/src apps/frontend/src packages/db/src packages/logger/src --fix",
    "outdated": "bun outdated --filter '*'",
    "typecheck": "bun --bun run --filter '*' typecheck && bun run typecheck:e2e",
    "db:generate": "bun --bun run --filter @ho-setup/db db:generate",
    "db:push": "bun --bun run --filter @ho-setup/db db:push",
    "db:migrate": "bun --bun run --filter @ho-setup/db db:migrate",
    "test": "bun test",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "test:e2e": "bun run typecheck:e2e && bunx playwright test",
    "typecheck:e2e": "bun --bun tsc --project e2e/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "bun-types": "~1.4.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.4.2"
}
