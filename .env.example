# Root-.env: lokal mit cp .env.example .env anlegen, niemals committen.
# Backend-Workspaces laden --env-file=../../.env; Astro nutzt vite.envDir.
# Deploy und Daemon-Wrapper laden diese Datei als Bash-Zuweisungen mit set -a.
# Werte mit Leerzeichen oder Sonderzeichen passend quotieren.

NODE_ENV=development
PORT=3005
LOG_LEVEL=info

# Exakte Frontend-Origins, ohne abschließenden Slash oder Pfad.
# Vor Produktion durch echte HTTPS-Origin(s) ersetzen. Kein Wildcard.
FRONTEND_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
# Nginx ist genau ein vertrauenswürdiger Proxy-Hop. Backend nur lokal binden.
TRUSTED_PROXY_HOPS=1

# PostgreSQL: Docker nur bei Datenbankarbeit erforderlich, kein Build-Zugriff.
# Lokal Port5435. Produktion braucht eigene Zugangsdaten und korrekte DB-Zuordnung.
DATABASE_URL=postgresql://db_user:db_password@localhost:5435/db_name
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
POSTGRES_DB=db_name

# Optionales Redis für Rate-Limiting; ohne Wert In-Memory.
# REDIS_URL=redis://:PASSWORT@127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Frontend-API: leer bedeutet gleiche Origin über Nginx /api.
# Der Astro-Dev-Server proxyt /api zum lokalen Backend-Port PORT.
# Für einen getrennten API-Host bei Bedarf dessen Origin angeben.
PUBLIC_API_URL=

# Nur Starwind CLI: echter Pro-Key gehört in apps/frontend/.env.local.
# Es wird keine fremde Projektlizenz mit dieser Vorlage ausgeliefert.
STARWIND_LICENSE_KEY=

# Deployment: bewusst vorbereitete, nicht automatisch aktivierte Ploi-Vorlagen.
# Exakt `git remote get-url origin` des abgeleiteten Projekts eintragen.
DEPLOY_REPOSITORY=https://github.com/Pote16/astro-starwind-hono-starter.git
# Fester vollständiger Supervisor-Prozessname, keine PID. Beispiel nur in Doku.
PLOI_DAEMON_NAME=
# Optionale eigene Runtime auf gemeinsamem Server: $BUN_INSTALL/bin/bun.
# Exakt .bun-version; der Hook führt nie ein globales Upgrade aus.
# BUN_INSTALL=/ABSOLUTER/RUNTIME-PFAD
# Destruktiver Schema-Push ist im Deploy verboten.
RESET_DB=false

# --- Einwilligung und Bot-Schutz ---
# Nur echte veröffentlichte URLs angeben; leer blendet Links im Cookie-Dialog aus.
PUBLIC_PRIVACY_URL_DE=
PUBLIC_PRIVACY_URL_EN=
# Beide Turnstile-Keys zusammen konfigurieren. Ohne Keys keine Cloudflare-Requests.
# Hostnamen im Turnstile-Dashboard erlauben; serverseitig FRONTEND_ORIGINS prüfen.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Resend: wiederverwendbarer Server-Helfer, kein Versand durch die Demo ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
MAIL_RECIPIENT=

# --- Browser: nur öffentliche IDs, immer einwilligungsgebunden ---
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_LINKEDIN_PARTNER_ID=
PUBLIC_LI_CONVERSION_LEAD=
PUBLIC_LI_CONVERSION_CONTACT=
PUBLIC_LI_CONVERSION_COMPLETEREGISTRATION=

# Auch ohne Browser-Pixel müssen reine Serverintegrationen eine Cookie-Auswahl anbieten.
# Diese Flags zeigen nur Einwilligungskategorien; sie laden keine Anbieterskripte.
PUBLIC_GA4_MP_ENABLED=false
PUBLIC_META_CAPI_ENABLED=false
PUBLIC_LINKEDIN_CAPI_ENABLED=false

# --- Server: frische Einwilligung pro Event erforderlich ---
GA4_MEASUREMENT_ID=
GA4_MP_API_SECRET=
META_PIXEL_ID=
META_ACCESS_TOKEN=
# Optional: dokumentierter, geprüfter API-Default im Code; dortige Updatehinweise beachten.
# META_API_VERSION=
# META_TEST_EVENT_CODE=
LINKEDIN_API_TOKEN=
# LINKEDIN_API_VERSION=
LINKEDIN_CONVERSION_ID=

# Microsoft Graph, Cal.com und Gemini sind nicht integriert.
# Solche Keys erst mit der jeweiligen Implementierung und Dokumentation ergänzen.
