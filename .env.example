# ----------------------------------------------------------------------------
# Astro+Hono-Setup — Umgebungsvorlage. Lokal: cp .env.example .env
# .env ist git-ignoriert; niemals echte Schlüssel committen oder ausgeben.
#
# Eine Datei, drei Leser:
#  - Bun lädt die .env aus dem Arbeitsverzeichnis (Backend-Skripte zeigen mit
#    --env-file=../../.env ausdrücklich hierher, Astro über vite.envDir).
#  - scripts/deploy.sh und scripts/cronjobs/run.sh laden sie als Bash-Zuweisungen
#    (set -a; source .env). Werte mit Leerzeichen oder Sonderzeichen deshalb in
#    doppelte Anführungszeichen setzen. ${VAR} wird von Bash UND Bun expandiert;
#    ein literales $ in Werten (z. B. Passwörtern) vermeiden.
#  - In Produktion schreibt Ploi "Site -> Environment" 1:1 in diese Datei; der
#    Ploi-Daemon liest sie beim Start. Änderungen wirken erst nach Neustart.
#
# Ein vierter Leser gehört NICHT dazu: dotenv. Das Backend lädt diese Datei nicht
# selbst, Bun erledigt das. Wer trotzdem ein apps/backend/src/env.ts mit dotenv
# einführt — etwa für einen Start aus apps/backend heraus, wo Bun nur dort sucht
# und nicht nach oben geht — MUSS dotenv-expand dazunehmen:
#
#     expand(config({ path: resolve(__dirname, "../../../.env"), quiet: true }));
#
# dotenv allein reicht ${VAR} wörtlich durch. In Produktion fällt das nie auf,
# weil Bun die Werte längst gesetzt hat und dotenv Gesetztes nicht überschreibt.
# apps/backend/src/startup.test.ts startet das Backend aber mit --no-env-file, um
# eine kontrollierte Umgebung zu haben — und dann ist dotenv die einzige Quelle.
# Am 8.9.2026 kostete genau diese eine fehlende Zeile in einer abgeleiteten Site
# einen halben Nachmittag: der Deploy scheiterte an einem zusammengesetzten
# REDIS_URL, während dieselbe .env-Form auf demselben Server überall sonst lief,
# und die Fehlermeldung zeigte auf die Environment, die korrekt war.
# scripts/harness.test.ts prüft diese Regel.
#
# Reihenfolge und Abschnitte sind in allen abgeleiteten Projekten gleich.
# ----------------------------------------------------------------------------

# --- Laufzeit ---
# Produktion MUSS NODE_ENV=production setzen (Ploi -> Site -> Environment).
# scripts/deploy.sh bricht sonst ab: der Daemon liest diese Datei, ein export
# im Deploy erreicht ihn nicht. production erzwingt FRONTEND_ORIGINS, das
# Turnstile-Schlüsselpaar und JSON-Logs.
NODE_ENV=development
# Backend-Port auf 127.0.0.1. Muss zu scripts/nginx.conf (proxy_pass) passen;
# pro Server ist jeder Port genau einer Site zugeordnet.
PORT=3005
# Pino: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info

# --- PostgreSQL (Einzelteile -> DATABASE_URL) ---
# docker-compose.yml liest POSTGRES_PORT/USER/PASSWORD/DB für die lokale
# Datenbank (Host-Port POSTGRES_PORT -> Container 5432). Produktion: nativer
# PostgreSQL auf dem Server, nur Loopback, eigener Benutzer und eigene Datenbank.
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
POSTGRES_DB=db_name
# Aus den Teilen zusammengesetzt; gelesen von packages/db (Bun SQL) und drizzle-kit.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis (optional, Einzelteile -> REDIS_URL) ---
# Ohne Werte arbeitet das Rate-Limiting im Arbeitsspeicher (pro Prozess).
# Nur einkommentieren, wenn wirklich ein Redis läuft; das Backend schaltet um,
# sobald REDIS_URL oder REDIS_HOST gesetzt ist.
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# --- URLs, CORS und Proxy ---
# Öffentliche Origin der Website ohne Pfad und ohne Endslash (Produktion: https).
# Astro leitet daraus site, Canonical, hreflang, Sitemap, Open Graph und robots.txt
# ab; das SEO-Gate im Deploy vergleicht den Build damit. Ungültige Werte brechen ab.
PUBLIC_SITE_URL=http://localhost:4321
# Exakte erlaubte Frontend-Origins für CORS und CSRF, kommagetrennt, kein Wildcard.
# Vor Produktion durch die echten HTTPS-Origins (mit und ohne www) ersetzen.
FRONTEND_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
# Nginx ist genau ein vertrauenswürdiger Proxy-Hop; Backend bindet nur lokal.
TRUSTED_PROXY_HOPS=1
# Frontend-API: leer bedeutet gleiche Origin über Nginx /api (lokal proxyt der
# Astro-Dev-Server /api zum Backend-Port). Nur für einen getrennten API-Host setzen.
PUBLIC_API_URL=

# --- Bot-Schutz (Cloudflare Turnstile, optional) ---
# Beide Schlüssel zusammen setzen oder beide leer lassen. Ohne Schlüssel kein
# Widget und kein Cloudflare-Aufruf. Hostnamen im Turnstile-Dashboard erlauben.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- E-Mail (Resend, serverintern) ---
# Leer bedeutet kein Versand; die Demo versendet nichts.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
MAIL_RECIPIENT=

# --- Rechtstexte und Einwilligung ---
# Nur echte veröffentlichte URLs; leer blendet die Links im Cookie-Dialog aus.
PUBLIC_PRIVACY_URL_DE=
PUBLIC_PRIVACY_URL_EN=
# Reine Serverintegrationen brauchen trotzdem eine Cookie-Auswahl; diese Flags
# zeigen nur Einwilligungskategorien, laden aber keine Anbieterskripte.
PUBLIC_GA4_MP_ENABLED=false
PUBLIC_META_CAPI_ENABLED=false
PUBLIC_LINKEDIN_CAPI_ENABLED=false

# --- Tracking im Browser (nur öffentliche IDs, immer einwilligungsgebunden) ---
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_LINKEDIN_PARTNER_ID=
PUBLIC_LI_CONVERSION_LEAD=
PUBLIC_LI_CONVERSION_CONTACT=
PUBLIC_LI_CONVERSION_COMPLETEREGISTRATION=

# --- Tracking auf dem Server (frische Einwilligung pro Event) ---
# GA4 Measurement Protocol: Measurement-ID muss PUBLIC_GA_MEASUREMENT_ID gleichen.
GA4_MEASUREMENT_ID=
GA4_MP_API_SECRET=
# Meta Conversions API: META_PIXEL_ID muss PUBLIC_META_PIXEL_ID gleichen.
META_PIXEL_ID=
META_ACCESS_TOKEN=
# META_API_VERSION=
# META_TEST_EVENT_CODE=
# LinkedIn Conversions API.
LINKEDIN_API_TOKEN=
# LINKEDIN_API_VERSION=
LINKEDIN_CONVERSION_ID=

# --- Starwind Pro (nur CLI, kein Laufzeitcode) ---
# Der echte Schlüssel gehört in apps/frontend/.env.local, nicht hierher.
STARWIND_LICENSE_KEY=

# --- Deploy (scripts/deploy.sh, nur Produktion) ---
# Zahl des eigenen Ploi-Daemons aus Ploi -> Site -> Daemons. Supervisor nennt
# das Programm worker-<id>; der Deploy startet ausschließlich dieses Programm
# neu. Wird nach jeder Neuanlage des Daemons neu vergeben.
PLOI_WORKER_ID=
# Muss fehlen oder false sein; jeder andere Wert stoppt den Deploy vor Änderungen.
RESET_DB=false
# Runtime dieser Site. Auf dem gemeinsamen Ploi-Server liegt je Bun-Version eine
# eigene Installation; der Pfad zeigt auf das Verzeichnis UEBER bin/bun und muss
# zu .bun-version passen. So hebt ein Upgrade nur diese eine Site.
#
# In Ploi -> Site -> Environment ist die Zeile PFLICHT und muss dort OHNE
# fuehrendes # stehen: Ploi schreibt die Maske 1:1 in die .env, eine
# Kommentarzeile setzt nichts, und der Deploy laeuft dann auf die alte
# gemeinsame Installation unter $HOME/.bun. Ebenso wenig duerfen Leerzeichen um
# das Gleichheitszeichen stehen; die Zeile setzt sonst nichts.
#
# Hier bleibt sie bewusst auskommentiert. Bun wertet BUN_INSTALL selbst aus, und
# zwar als Wurzel fuer Paket-Cache und globale Bins. Lokal (cp .env.example .env)
# wuerde ein Serverpfad damit jeden bun-Aufruf auf ein Verzeichnis umbiegen, das
# es auf der Entwicklermaschine nicht gibt.
#
# Derselbe Pfad gehoert ins Daemon-Kommando (scripts/ploi-daemon.md).
# BUN_INSTALL=/home/ploi/.bun-versions/1.4.2
