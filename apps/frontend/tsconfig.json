{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["bun-types", "astro/client"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "tools/**/*", "astro.config.mjs"],
  "exclude": ["node_modules", "dist"]
}
