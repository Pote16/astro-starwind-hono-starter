---
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/starwind/card";

import Layout from "../layouts/Layout.astro";
---

<Layout title="Astro Starwind Blank Starter">
  <script is:inline slot="head">
    const prefs = navigator.languages || [navigator.language];
    if (prefs.some((l) => l.startsWith("en"))) {
      window.location.replace("/en" + window.location.search);
    }
  </script>
  <main class="flex min-h-screen flex-col items-center justify-center bg-background p-4">
    <Card class="w-full max-w-lg">
      <CardHeader>
        <div class="flex items-center gap-2">
          <CardTitle>Astro + Starwind Starter</CardTitle>
          <Badge variant="secondary">v2</Badge>
        </div>
        <CardDescription>
          Deine neue Leinwand. Baue etwas Großartiges. (Root locale fallback)
        </CardDescription>
      </CardHeader>
      <CardContent>
        <p class="text-muted-foreground">
          Starwind UI 2 mit Tailwind CSS v4, Hono API und Drizzle ORM — alles im
          Bun Monorepo.
        </p>
      </CardContent>
      <CardFooter class="flex flex-wrap gap-3">
        <Button variant="primary" href="https://starwind.dev" target="_blank" rel="noreferrer">
          Starwind Docs
        </Button>
        <Button variant="outline" href="/en">English</Button>
      </CardFooter>
    </Card>
  </main>
</Layout>
