---
import { Button } from "@/components/starwind/button";
import Layout from "@/layouts/Layout.astro";

// Nginx liefert diese Datei über error_page 404 für jede unbekannte URL mit
// Status 404. Die Sprache ist zur Buildzeit unbekannt; deshalb beide Sprachen
// und keine hreflang-Alternativen. Die Seite darf nicht indexiert werden.
---

<Layout title="404 – Seite nicht gefunden | Page not found" noindex>
  <main
    class="flex min-h-screen flex-col items-center justify-center gap-6 bg-background px-4 py-10"
  >
    <section class="w-full max-w-lg space-y-3 text-center" lang="de">
      <p class="text-sm font-medium text-muted-foreground">Fehler 404</p>
      <h1 class="text-3xl font-semibold tracking-tight">Seite nicht gefunden</h1>
      <p class="text-muted-foreground">
        Die angeforderte Adresse existiert nicht oder wurde verschoben.
      </p>
      <Button variant="primary" href="/">Zur Startseite</Button>
    </section>
    <section class="w-full max-w-lg space-y-3 text-center" lang="en">
      <p class="text-sm font-medium text-muted-foreground">Error 404</p>
      <h2 class="text-2xl font-semibold tracking-tight">Page not found</h2>
      <p class="text-muted-foreground">The requested address does not exist or has moved.</p>
      <Button variant="outline" href="/en/" hreflang="en" lang="en">Go to homepage</Button>
    </section>
  </main>
</Layout>
