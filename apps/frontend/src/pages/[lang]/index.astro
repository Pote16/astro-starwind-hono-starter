---
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/starwind/card";

import { defaultLang, type Lang, languages } from "../../i18n/ui";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  const supportedLangs = Object.keys(languages) as Lang[];
  return supportedLangs
    .filter((l) => l !== defaultLang)
    .map((l) => ({ params: { lang: l } }));
}
---

<Layout title="Astro Starwind Blank Starter">
  <main class="flex min-h-screen flex-col items-center justify-center bg-background p-4">
    <Card class="w-full max-w-lg">
      <CardHeader>
        <div class="flex items-center gap-2">
          <CardTitle>Astro + Starwind Starter</CardTitle>
          <Badge variant="secondary">v2</Badge>
        </div>
        <CardDescription>
          Your new blank canvas. Build something amazing.
        </CardDescription>
      </CardHeader>
      <CardContent>
        <p class="text-muted-foreground">
          Starwind UI 2 with Tailwind CSS v4, Hono API, and Drizzle ORM — all in
          a Bun monorepo.
        </p>
      </CardContent>
      <CardFooter class="flex flex-wrap gap-3">
        <Button variant="primary" href="https://starwind.dev" target="_blank" rel="noreferrer">
          Starwind Docs
        </Button>
        <Button variant="outline" href="/">Deutsch</Button>
      </CardFooter>
    </Card>
  </main>
</Layout>
