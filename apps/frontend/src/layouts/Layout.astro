---
import "../styles/global.css";
import "vanilla-cookieconsent/dist/cookieconsent.css";

import TrackingHead from "../components/TrackingHead.astro";
import { getLangFromLocale } from "../i18n/utils";

interface Props {
  title: string;
  /** Seiten, die nie indexiert werden dürfen (404, Danke-Seiten). */
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;
const lang = getLangFromLocale(Astro.currentLocale);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro + Starwind + Hono Starter Project" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <TrackingHead />
    <slot name="head" />
  </head>
  <body class="min-h-screen antialiased">
    <slot />
    <script>
      import "../scripts/cookie-consent";
    </script>
  </body>
</html>
