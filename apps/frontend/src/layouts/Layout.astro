---
import "../styles/global.css";
import "vanilla-cookieconsent/dist/cookieconsent.css";

import type { ImageMetadata } from "astro";
import { Font, getImage } from "astro:assets";
import { getAbsoluteLocaleUrl } from "astro:i18n";

import JsonLd from "../components/JsonLd.astro";
import TrackingHead from "../components/TrackingHead.astro";
import { SITE } from "../data/site";
import { defaultLang, type Lang, languages } from "../i18n/ui";
import { getLangFromLocale, useTranslations } from "../i18n/utils";
import {
  type BreadcrumbEintrag,
  breadcrumbSchema,
  organizationSchema,
  websiteSchema,
} from "../lib/schema";
import { istNoindexSeite, seitenKennung } from "../lib/seiten";

/**
 * Basis-Layout aller Seiten: Meta-Daten, Canonical, hreflang, Open Graph,
 * Favicons, Font-Preload, strukturierte Daten, Consent und Tracking-Bootstrap.
 * Jede Seite übergibt Titel und Beschreibung; beide müssen je Seite und Sprache
 * eindeutig sein (Build-Gate tools/pruefe-seo.ts).
 */
interface Props {
  /** Vollständiger Seitentitel, je Sprache verschieden (src/i18n/ui.ts). */
  title: string;
  /** Meta-Description, je Seite und Sprache eindeutig, höchstens ~155 Zeichen. */
  description: string;
  /** Nie indexieren (404, Danke-Seiten): kein Canonical, kein hreflang, nicht in der Sitemap. */
  noindex?: boolean;
  /** Abweichendes Vorschaubild aus src/assets; wird zur Bauzeit auf 1200×630 gebracht. */
  image?: { src: ImageMetadata; alt: string };
  /** Brotkrümelpfad für das BreadcrumbList-Schema auf Unterseiten. */
  breadcrumbs?: BreadcrumbEintrag[];
}

const { title, description, noindex: noindexProp = false, image, breadcrumbs = [] } = Astro.props;
const lang = getLangFromLocale(Astro.currentLocale);
const t = useTranslations(lang);
const sprachen = Object.keys(languages) as Lang[];

const pfad = Astro.url.pathname;
const noindex = noindexProp || istNoindexSeite(pfad);
const basis = Astro.site ?? new URL(SITE.origin);
// Selbstreferenzierend, absolut, mit Endslash (trailingSlash "always").
const kanonisch = new URL(pfad, basis).href;

// hreflang nur für indexierbare Seiten. Jede Seite existiert unter derselben
// Kennung in allen Sprachen; x-default zeigt auf die Standardsprache, weil es
// keine Sprachweiche und keinen Browser-Redirect gibt.
const kennung = seitenKennung(pfad).replace(/^\//, "");
const sprachlinks = noindex
  ? []
  : sprachen.map((sprache) => ({ sprache, url: getAbsoluteLocaleUrl(sprache, kennung) }));
const xDefault = sprachlinks.find(({ sprache }) => sprache === defaultLang)?.url;

// Vorschaubild zur Bauzeit auf 1200×630 gebracht; die Maße sind damit sicher.
const ogQuelle = image?.src ?? SITE.defaultOgImage;
const ogBild = await getImage({
  src: ogQuelle,
  width: 1200,
  height: 630,
  format: "png",
  layout: "none",
});
const ogBildUrl = new URL(ogBild.src, basis).href;
const ogBildAlt = image?.alt ?? SITE.ogImageAlt[lang];
const ogLocaleAlternates = noindex
  ? []
  : sprachen.filter((sprache) => sprache !== lang).map((sprache) => SITE.ogLocale[sprache]);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"}
    />
    {!noindex && <link rel="canonical" href={kanonisch} />}
    {sprachlinks.map(({ sprache, url }) => <link rel="alternate" hreflang={sprache} href={url} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={kanonisch} />}
    <meta property="og:locale" content={SITE.ogLocale[lang]} />
    {ogLocaleAlternates.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
    <meta property="og:image" content={ogBildUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogBildAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogBildUrl} />

    {/* Symbole aus public/, erzeugt mit tools/erzeuge-icons.ts aus favicon.svg. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={SITE.themeColor} />

    {
      /* Genau eine Schrift wird vorgeladen: Preloads konkurrieren mit dem
        LCP-Bild um Bandbreite. Die Fonts-API liefert @font-face samt
        metrisch angepasstem Fallback (src/styles/global.css nutzt --font-inter). */
    }
    <Font cssVariable="--font-inter" preload />

    <JsonLd data={organizationSchema(lang)} />
    <JsonLd data={websiteSchema(lang)} />
    {breadcrumbs.length > 0 && <JsonLd data={breadcrumbSchema(breadcrumbs)} />}

    <TrackingHead />
    <slot name="head" />
  </head>
  <body class="min-h-screen antialiased">
    {/* Sprunglink: unsichtbar bis zum Tastaturfokus. Seiten rendern <main id="inhalt">. */}
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground focus:shadow-lg"
    >
      {t("seo.skip")}
    </a>
    <slot />
    <script>
      import "../scripts/cookie-consent";
    </script>
  </body>
</html>
