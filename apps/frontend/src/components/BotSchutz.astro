---
import { Button } from "@/components/starwind/button";
import { formularUebersetzung } from "@/i18n/formular";
import { getLangFromLocale } from "@/i18n/utils";
import { turnstileSitekeySchema } from "@/schemas/turnstile.schema";

interface Props {
  action: string;
}
const { action } = Astro.props;
const sitekey = turnstileSitekeySchema.parse(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY);
const sprache = getLangFromLocale(Astro.currentLocale);
const t = formularUebersetzung(sprache);
---

{
  sitekey && (
    <div
      class="w-full min-w-0"
      data-turnstile
      data-sitekey={sitekey}
      data-aktion={action}
      data-sprache={sprache}
      role="group"
      aria-label={t("sicherheitspruefung")}
    >
      <div class="w-full min-w-0" data-turnstile-widget />
      <p class="mt-2 text-sm" data-turnstile-status role="status" hidden />
      <Button
        type="button"
        variant="outline"
        class="mt-3 [&[hidden]]:hidden"
        data-turnstile-wiederholen
        hidden
      >
        {t("pruefungNeuLaden")}
      </Button>
      <noscript>
        <p class="mt-2 text-sm">{t("pruefungOhneJs")}</p>
      </noscript>
    </div>
  )
}
<script>
  import { entferneBotSchutz, initBotSchutz } from "../scripts/turnstile";
  initBotSchutz();
  document.addEventListener("astro:after-swap", initBotSchutz);
  document.addEventListener("astro:before-swap", entferneBotSchutz);
</script>
