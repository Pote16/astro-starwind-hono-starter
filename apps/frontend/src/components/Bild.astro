---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

/**
 * Inhaltsbild aus src/assets: AVIF mit WebP-Rückfall, srcset/sizes aus
 * image.layout "constrained" (astro.config.mjs), feste width/height gegen
 * Layoutsprünge. Alle Bilder laden lazy, außer dem einen LCP-Bild der Seite
 * mit `priority` (eager, fetchpriority=high, decoding=sync). Bilder aus
 * public/ werden nicht optimiert und gehören nur für Icons dorthin.
 * Details: src/assets/README.md.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  /** Höchstens ein Bild pro Seite: das größte sichtbare Bild beim Laden. */
  priority?: boolean;
  /** Breiten für srcset; ohne Angabe leitet Astro sie aus dem Layout ab. */
  widths?: number[];
  /** Tatsächliche Darstellungsbreite, z. B. "(max-width: 640px) 100vw, 512px". */
  sizes?: string;
  /** AVIF q62 entspricht etwa WebP q80 bei 25–40 % weniger Bytes. */
  quality?: number;
  class?: string;
}

const { src, alt, priority = false, widths, sizes, quality = 62, class: className } = Astro.props;
---

<Picture
  src={src}
  alt={alt}
  formats={["avif"]}
  fallbackFormat="webp"
  quality={quality}
  priority={priority}
  {...widths ? { widths } : {}}
  {...sizes ? { sizes } : {}}
  class={className}
/>
