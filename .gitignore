# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
dist.new/
dist.old/
.deploy/

# Ploi legt sein Deploy-Script bei jedem Deploy als ploi-<hash>.sh im
# Site-Verzeichnis ab. Verankert mit /, damit scripts/ploi-autodeploy.sh
# versioniert bleibt. Ohne diesen Eintrag würde deploy.sh die Datei als
# unversionierte Änderung melden.
/ploi-*.sh

# Persistente Dateien neben dem Checkout (überleben git reset --hard)
storage/
.astro/
.output/
build/
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example

# IDE & OS
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/
*.lcov

# Starwind Pro (Lizenzschlüssel in .env.local)
apps/frontend/.env.local

# Misc
.cache/
.turbo/

# Lokale Playwright-Ergebnisse
test-results/
playwright-report/
blob-report/
